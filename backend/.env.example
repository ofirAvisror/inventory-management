# =====================================================================
# Backend environment template.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All values below are placeholders only - none of them are real secrets.
# =====================================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=3000

# ---------- Database ----------
# MongoDB connection string. Atlas example:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbName>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/guru-inventory

# ---------- JWT / Auth ----------
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
ACCESS_TOKEN_COOKIE_NAME=access_token
COOKIE_SECURE=false

# ---------- Admin simulation (per assignment spec) ----------
# Any request carrying this header with this exact value is treated as Admin.
# Must be at least 16 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_HEADER_NAME=x-admin-role
ADMIN_HEADER_VALUE=replace-with-a-random-32-char-hex-token

# ---------- Frontend URLs ----------
FRONTEND_PUBLIC_URL=http://localhost:5173
# Comma-separated list of allowed CORS origins
FRONTEND_URLS=http://localhost:5173

# ---------- Email verification & password reset ----------
EMAIL_VERIFICATION_EXPIRE_MINUTES=1440
PASSWORD_RESET_EXPIRE_MINUTES=60

# ---------- SMTP (Gmail example) ----------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-mailer@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-mailer@example.com
MAIL_FROM_NAME=Guru Inventory Management

# ---------- Rate limiting (per IP, per window) ----------
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_PERIOD=60

# ---------- Login lockout / Slack alert thresholds ----------
LOGIN_FAIL_THRESHOLD=5
LOGIN_FAIL_WINDOW_MINUTES=60

# ---------- Slack webhooks (fire-and-forget alerts) ----------
# Set to false to disable all Slack notifications globally.
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL_NEW_USERS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL_ALERTS_SECURITY=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL_INVENTORY_STATUS_OPS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL_INVENTORY_BULK_ACTIONS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL_INVENTORY_AUDIT_OVERRIDE=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---------- Cloudinary (product images) ----------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_FOLDER=guru-inventory/products
CLOUDINARY_UPLOAD_TIMEOUT_MS=30000

# ---------- Upload limits ----------
# 5 MB = 5242880. Applies to both multer and Cloudinary.
MAX_UPLOAD_BYTES=5242880
