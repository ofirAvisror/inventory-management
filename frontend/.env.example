# =====================================================================
# Frontend environment template (Vite).
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only variables prefixed with VITE_ are exposed to the client.
# =====================================================================

# Base URL of the backend API. Must include the protocol but no trailing slash.
VITE_API_URL=http://localhost:3000

# Admin role simulation (per assignment spec).
# These MUST match ADMIN_HEADER_NAME and ADMIN_HEADER_VALUE in backend/.env
# exactly. When the "Act as Admin" toggle is on in the UI, the frontend
# attaches this header to every request, and the backend treats the
# request as an admin call.
VITE_ADMIN_HEADER_NAME=x-admin-role
VITE_ADMIN_HEADER_VALUE=replace-with-the-same-value-as-backend-ADMIN_HEADER_VALUE
